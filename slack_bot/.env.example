# ---- Slack (Socket Mode) -------------------------------------------------
# Both tokens may live in the credentials file instead of here:
#   ~/.config/slack/credentials.json  ->  {"bot_token": "xoxb-...", "app_token": "xapp-..."}
# (same file post_slack_message.py reads). Values set here or in the real
# environment override the file.
#SLACK_CREDENTIALS_FILE=/Users/me/.config/slack/credentials.json
# App-level token, scope connections:write (Socket Mode). Required somewhere.
#SLACK_APP_TOKEN=xapp-...
# Bot token (xoxb-). Scopes: app_mentions:read chat:write im:history im:read
# im:write users:read.email, optional files:write (long replies as a file).
#SLACK_BOT_TOKEN=xoxb-...
# Space/comma separated Slack user ids allowed to use the bot. Empty = anyone in the workspace.
#SLACK_BOT_ALLOWED_USERS=U01ABCDEF U02GHIJKL

# ---- Claude Code ----------------------------------------------------------
#CLAUDE_BIN=claude
#CLAUDE_MODEL=
# Permission mode for the headless run. acceptEdits + the allow-list below lets
# skill scripts run without prompts; use bypassPermissions only if a tool you
# need is not covered by the list.
#CLAUDE_PERMISSION_MODE=acceptEdits
#CLAUDE_ALLOWED_TOOLS=Bash Read Write Edit Glob Grep Agent Skill ToolSearch WebFetch WebSearch
# Wall-clock cap per request (a full main-failures run can take 30-60 min).
#CLAUDE_TIMEOUT_SECONDS=3600
# Where claude runs (skills are discovered from <repo>/.claude/, synced by the launcher)
#CI_ANALYSIS_REPO=/Users/me/Documents/GitHub/CI_analysis
#CI_ANALYSIS_SKILLS_DIR=/Users/me/Documents/GitHub/CI_analysis/skills

# ---- Bot behaviour ----------------------------------------------------------
#SLACK_BOT_MAX_CONCURRENT=2
# /fetch runs fetch_failures.py directly (no Claude); wall-clock cap in seconds.
#SLACK_BOT_FETCH_TIMEOUT=300
#SLACK_BOT_PROGRESS_INTERVAL=60
#SLACK_BOT_DEFAULT_SKILL=trtllm-main-failures-analysis
#SLACK_BOT_LOG_LEVEL=INFO
#SLACK_BOT_STATE_DIR=./.state
#SLACK_BOT_LOG_DIR=./out

# Anthropic endpoint overrides are inherited from the bot's environment
# (ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / ANTHROPIC_MODEL) if you set them.
